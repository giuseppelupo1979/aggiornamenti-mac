#!/bin/sh
# aggiornamenti — avvia il server locale e apre la pagina.
#
#   aggiornamenti            avvia (se serve) e apre la pagina
#   aggiornamenti start      avvia in background senza aprire la pagina
#   aggiornamenti stop       ferma il server
#   aggiornamenti demo       apre la modalità demo (dati finti, nessuna modifica al sistema)
#   aggiornamenti app        crea l'app "Aggiornamenti" sulla Scrivania
#   aggiornamenti version    mostra la versione
#   AGG_PORT=9000 aggiornamenti   usa un'altra porta invece della 8765

DIR="${AGGIORNAMENTI_HOME:-$(cd "$(dirname "$0")" && pwd)}"
SELF="${AGGIORNAMENTI_BIN:-$DIR/aggiornamenti}"
LOG="$HOME/Library/Logs/AggiornamentiMac.log"
PORT="${AGG_PORT:-8765}"
TOKEN_FILE="$HOME/Library/Application Support/AggiornamentiMac/token"
# la pagina accetta comandi solo con il codice che il server scrive in TOKEN_FILE
page() { open "http://127.0.0.1:$1/#t=$(cat "$TOKEN_FILE" 2>/dev/null)"; }

log() { mkdir -p "$(dirname "$LOG")"; echo "$(date '+%Y-%m-%d %H:%M:%S') aggiornamenti: $*" >> "$LOG"; }

# Python: quello indicato, poi Homebrew (anche solo con il nome versionato, python3.14:
# dopo alcuni aggiornamenti Homebrew non crea più il comando python3), infine quello di Apple
PY=""
for p in "$PYTHON" /opt/homebrew/bin/python3 $(ls -r /opt/homebrew/bin/python3.[0-9]* /usr/local/bin/python3.[0-9]* 2>/dev/null | grep -E 'python3\.[0-9]+$') /usr/local/bin/python3 /usr/bin/python3; do
  if [ -n "$p" ] && [ -x "$p" ] && "$p" -c "import sys; sys.exit(sys.version_info < (3, 9))" 2>/dev/null; then PY="$p"; break; fi
done
[ -n "$PY" ] || { log "python3 non trovato"; echo "python3 non trovato / python3 not found" >&2; exit 1; }
[ -r "$DIR/server.py" ] || { log "non riesco a leggere $DIR/server.py"; echo "server.py non leggibile: $DIR / cannot read server.py" >&2; exit 1; }

up() { curl -s --max-time 2 -o /dev/null "http://127.0.0.1:$1/api/state"; }

start() { # $1 porta, $2 argomenti extra
  if ! up "$1"; then
    log "avvio con $PY"
    nohup "$PY" "$DIR/server.py" $2 < /dev/null >> "$LOG" 2>&1 &
    i=0
    while [ $i -lt 30 ]; do up "$1" && return 0; sleep 0.5; i=$((i + 1)); done
    log "il server non risponde dopo 15 secondi"
    echo "Il server non risponde: vedi $LOG / Server not responding: see $LOG" >&2
    return 1
  fi
}

case "${1:-open}" in
  open)
    start "$PORT" && page "$PORT" ;;
  start)
    start "$PORT" ;;
  stop)
    pids=$(lsof -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null)
    [ -n "$pids" ] && kill $pids ;;
  demo)
    start 8766 --demo && open "http://127.0.0.1:8766" ;;
  app)
    APP="$HOME/Desktop/Aggiornamenti.app"
    ICON=/System/Library/PrivateFrameworks/SoftwareUpdate.framework/Versions/A/Resources/SoftwareUpdate.icns
    # app vera con l'icona nella barra dei menu, se c'è il compilatore Swift (strumenti da riga di
    # comando di Apple, già richiesti da Homebrew); altrimenti il semplice lanciatore AppleScript
    if command -v swiftc > /dev/null 2>&1 && [ -f "$DIR/menubar.swift" ]; then
      BUILD="$(mktemp -d -t aggiornamenti-app)"
      mkdir -p "$BUILD/Aggiornamenti.app/Contents/MacOS" "$BUILD/Aggiornamenti.app/Contents/Resources"
      if swiftc -O -o "$BUILD/Aggiornamenti.app/Contents/MacOS/Aggiornamenti" "$DIR/menubar.swift" >> "$LOG" 2>&1; then
        V=$(sed -n 's/^VERSION = "\(.*\)".*/\1/p' "$DIR/server.py")
        cat > "$BUILD/Aggiornamenti.app/Contents/Info.plist" <<EOP
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.aggiornamenti-mac.bar</string>
  <key>CFBundleName</key><string>Aggiornamenti</string>
  <key>CFBundleExecutable</key><string>Aggiornamenti</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$V</string>
  <key>CFBundleIconFile</key><string>applet</string>
  <key>LSUIElement</key><true/>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>AGGLauncher</key><string>$SELF</string>
  <key>AGGLog</key><string>$LOG</string>
</dict></plist>
EOP
        [ -f "$ICON" ] && cp "$ICON" "$BUILD/Aggiornamenti.app/Contents/Resources/applet.icns"
        codesign --force --deep -s - "$BUILD/Aggiornamenti.app" > /dev/null 2>&1
        osascript -e 'tell application id "com.aggiornamenti-mac.bar" to quit' > /dev/null 2>&1
        rm -rf "$APP" && mv "$BUILD/Aggiornamenti.app" "$APP" && rm -rf "$BUILD"
        touch "$APP"
        echo "$APP"
        exit 0
      fi
      rm -rf "$BUILD"
      log "compilazione dell'icona nella barra dei menu non riuscita: uso il lanciatore semplice"
    fi
    SCRIPT="$(mktemp -t aggiornamenti).applescript"
    # gli errori finiscono nel registro e l'avviso dice dove guardare, invece del generico
    # "Il comando è terminato con uno stato non-zero"
    cat > "$SCRIPT" <<EOS
try
  do shell script quoted form of "$SELF" & " open >> " & quoted form of "$LOG" & " 2>&1"
on error errMsg number errNum
  display alert "Aggiornamenti non è partito (codice " & errNum & ")" message "Dettagli nel registro: $LOG" & return & return & "Puoi avviarlo anche dal Terminale con: " & quoted form of "$SELF" as warning
end try
EOS
    rm -rf "$APP"
    osacompile -o "$APP" "$SCRIPT" && rm -f "$SCRIPT"
    if [ -f "$ICON" ]; then
      cp "$ICON" "$APP/Contents/Resources/applet.icns"
      rm -f "$APP/Contents/Resources/Assets.car"
      /usr/libexec/PlistBuddy -c "Delete :CFBundleIconName" "$APP/Contents/Info.plist" 2>/dev/null
    fi
    codesign --force --deep -s - "$APP" > /dev/null 2>&1
    touch "$APP"
    echo "$APP" ;;
  version|--version|-v)
    sed -n 's/^VERSION = "\(.*\)".*/\1/p' "$DIR/server.py" ;;
  help|--help|-h)
    sed -n '2,10p' "$DIR/aggiornamenti" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "Uso / Usage: aggiornamenti [open|start|stop|demo|app|version]" >&2; exit 2 ;;
esac
